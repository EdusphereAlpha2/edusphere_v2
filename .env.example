# ---------------------------------------------------------------------------
# Database — PostgreSQL
#
# Supabase gives you both URLs under Project Settings -> Database -> Connection
# string. Replace <PROJECT-REF>, <PASSWORD> and <REGION> with your own values.
# The password is URL-encoded, so escape any special characters (@ -> %40 etc).
#
# DATABASE_URL  runtime queries. Use the transaction pooler (port 6543) with
#               pgbouncer=true so serverless functions do not exhaust the
#               connection limit.
# DIRECT_URL    a direct, non-pooled session (port 5432). Prisma Migrate and
#               scripts/port-to-postgres.mjs need this; pgbouncer cannot run
#               the statements they issue.
#
# Moving to the on-premises server later means changing only these two lines,
# for example:
#   DATABASE_URL="postgresql://edusphere:<PASSWORD>@10.0.0.20:5432/edusphere360?schema=public"
#   DIRECT_URL="postgresql://edusphere:<PASSWORD>@10.0.0.20:5432/edusphere360?schema=public"
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres.<PROJECT-REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.<PROJECT-REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:5432/postgres"

# Signs session cookies. Generate one with:  openssl rand -base64 32
# Production refuses to start without it — a committed default would let
# anyone mint a session for any user, including an administrator.
SESSION_SECRET="replace-me-with-a-random-32-byte-value"

# ---------------------------------------------------------------------------
# AI Exam Grader (Teacher -> Grading -> AI Exam Grader)
#
# DATALAB_API_KEY         optionally uses Chandra OCR for scanned PDFs and images.
#                         Set this on the server (for example, Vercel) to enable it.
# PADDLEOCR_ACCESS_TOKEN  existing OCR fallback when DATALAB_API_KEY is not set.
# GROQ_API_KEY            primary grading provider (fast, free tier).
# GEMINI_API_KEY          second fallback, tried after Groq and before OpenAI -
#                         also free-tier, with a much higher per-request token
#                         limit than Groq's for a long paper. Get one at
#                         aistudio.google.com/apikey.
# OPENAI_API_KEY          last-resort fallback, used only if every Groq and
#                         Gemini account is rate-limited/unavailable.
# Vercel Blob: connect the private Blob store to the Vercel project. Vercel
#              injects BLOB_STORE_ID and OIDC credentials automatically.
#              For local development, use a Blob read-write token.
# ---------------------------------------------------------------------------
DATALAB_API_KEY=""
PADDLEOCR_ACCESS_TOKEN="replace-me"
GROQ_API_KEY="replace-me"
GEMINI_API_KEY=""
OPENAI_API_KEY=""
BLOB_READ_WRITE_TOKEN=""

